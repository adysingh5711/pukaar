{
  "name": "pukaar_core",
  "display_name": "Pukaar Core",
  "version": "0.4.2",
  "type": "core",
  "interface": "cdylib",
  "category": "civic",
  "description": "Core of Pukaar, a community issue tracker where residents confirm the fix",
  "main": "pukaar_core_plugin",
  "dependencies": ["delivery_module", "storage_module", "chat_module"],
  "codegen": {
    "rust": { "crate": "rust-lib", "trait": "PukaarCoreModule" }
  },
  "nix": {
    "packages": { "build": [], "runtime": [] },
    "rust": { "toolchain": "1.98.1", "packages": { "build": ["clang", "pkg-config", "rustPlatform.bindgenHook"], "runtime": [] } },
    "external_libraries": [],
    "cmake": { "find_packages": [], "extra_sources": [], "extra_include_dirs": [], "extra_link_libraries": [] },
    "platforms": [
      { "when": { "os": "linux" },
        "packages": { "runtime": ["pcsclite"] },
        "rust": { "packages": { "runtime": ["pcsclite"] } } }
    ]
  }
}
